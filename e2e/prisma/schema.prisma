generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:./test.db"
}

model AppUser {
    id                         BigInt   @default(autoincrement())
    is_deleted                 Boolean  @default(false)
    username                   String   @unique
    firstname                  String
    lastname                  String
    password                   String
    email                      String
    nonlocked                  Boolean
    enabled                    Boolean
    last_time_password_updated DateTime @default("1970-01-01T00:00:00.000Z")
    password_never_expires     Boolean  @default(false)
    cannot_change_password     Boolean  @default(false)

    roles AppUserRole[]

    @@id([id])
    @@map("appuser")
}

model Role {
    id          BigInt  @default(autoincrement())
    name        String  @unique
    description String
    is_disabled Boolean @default(false)

    appUsers AppUserRole[]

    @@id([id])
    @@map("role")
}

model AppUserRole {
    appuser_id BigInt
    role_id    BigInt
    AppUser    AppUser @relation(fields: [appuser_id], references: [id])
    Role       Role    @relation(fields: [role_id], references: [id])

    @@id([appuser_id, role_id])
    @@map("appuser_role")
}

model Clients {
  client_id    Int     @id @default(autoincrement())
  client_name  String
  address      String
  phone        String
  Users        Users[]
  Orders       Orders[]
}

model Users {
  user_id           Int       @id @default(autoincrement())
  username          String    @unique
  password          String
  registration_date DateTime
  client_id         Int?
  Clients           Clients?  @relation(fields: [client_id], references: [client_id])
  Orders            Orders[]
}

model Orders {
  order_id      Int       @id @default(autoincrement())
  user_id       Int
  client_id     Int
  order_date    DateTime
  total_amount  Float
  Users         Users     @relation(fields: [user_id], references: [user_id])
  Clients       Clients   @relation(fields: [client_id], references: [client_id])
  OrderItems    OrderItems[]
}

model Products {
  product_id    Int       @id @default(autoincrement())
  product_name  String
  price         Float
  OrderItems    OrderItems[]
}

model OrderItems {
  order_id    Int
  product_id  Int
  quantity    Int
  Orders      Orders    @relation(fields: [order_id], references: [order_id])
  Products    Products  @relation(fields: [product_id], references: [product_id])
  @@id([order_id, product_id])
}